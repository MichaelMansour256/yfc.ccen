# ============================================================================
# e3dady.ccen — Church Meeting Website Template
# Copy this file to `.env.local` (never commit real secrets) and fill in the
# values for YOUR meeting. See TEMPLATE.md for the full setup guide.
# ============================================================================

# ─── Public (safe for the browser, exposed in the client bundle) ────────────

# Supabase project (prayer wall + notification history). One project per meeting.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret (Supabase dashboard → Project Settings → API → service_role).
# Required for staff-only attendance: server routes use it so attendance can
# never be written with the publishable key. Apply supabase-attendance-lockdown.sql.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary cloud account (gallery images, invitations, meeting JSON data).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# OneSignal web-push app id (same value as ONESIGNAL_APP_ID below).
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# Public site URL — base for push-notification click-through links
# (e.g. https://your-meeting.vercel.app). Falls back to siteConfig.url.
NEXT_PUBLIC_SITE_URL=

# ─── Server-only secrets (NEVER expose these) ───────────────────────────────

# Cloudinary API credentials (uploads + folder management).
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin dashboard password (sent as x-admin-password header by /admin).
ADMIN_PASSWORD=

# OneSignal REST API key (server-side sends).
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Bearer token protecting /api/cron/* and /api/test-notification.
CRON_SECRET=

# ─── Meeting-specific optional overrides ────────────────────────────────────

# Cloudinary folder holding this meeting's app data (events JSON,
# verse-of-week JSON). Default when unset: "e3dady_events".
# For a NEW meeting using a shared Cloudinary account, set your own folder
# so you don't touch the E3dady namespace.
CLOUDINARY_MEETING_FOLDER=
